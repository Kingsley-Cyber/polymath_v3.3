{
  "version": "1.0.0",
  "result_contract": "schemas/benchmark_result.schema.json",
  "groups": {
    "structural": [
      {
        "path": "checks.cpu_only",
        "op": "eq",
        "value": true,
        "required": true
      },
      {
        "path": "checks.single_warm_model",
        "op": "eq",
        "value": true,
        "required": true
      },
      {
        "path": "checks.retired_runtime_models_loaded",
        "op": "eq",
        "value": 0,
        "required": true
      },
      {
        "path": "checks.parse_once",
        "op": "eq",
        "value": true,
        "required": true
      },
      {
        "path": "checks.raw_mention_conservation",
        "op": "eq",
        "value": true,
        "required": true
      },
      {
        "path": "checks.entity_reducer_conservation",
        "op": "eq",
        "value": true,
        "required": true
      },
      {
        "path": "checks.relation_decision_conservation",
        "op": "eq",
        "value": true,
        "required": true
      },
      {
        "path": "checks.graph_rebuild_match",
        "op": "eq",
        "value": true,
        "required": true
      },
      {
        "path": "checks.idempotent_second_run",
        "op": "eq",
        "value": true,
        "required": true
      }
    ],
    "entity_quality": [
      {
        "path": "metrics.entity.exact_span_precision",
        "op": "ge",
        "value": 0.9,
        "required": true
      },
      {
        "path": "metrics.entity.exact_span_recall",
        "op": "ge",
        "value": 0.8,
        "required": true
      },
      {
        "path": "metrics.entity.exact_span_f1",
        "op": "ge",
        "value": 0.85,
        "required": true
      },
      {
        "path": "metrics.entity.type_f1",
        "op": "ge",
        "value": 0.85,
        "required": true
      },
      {
        "path": "metrics.entity.strict_alignment_rate",
        "op": "eq",
        "value": 1.0,
        "required": true
      },
      {
        "path": "metrics.entity.accepted_pronoun_endpoints",
        "op": "eq",
        "value": 0,
        "required": true
      },
      {
        "path": "metrics.entity.generic_noun_false_positive_rate",
        "op": "le",
        "value": 0.05,
        "required": true
      },
      {
        "path": "checks.ambiguous_surface_cross_sense_merge",
        "op": "eq",
        "value": false,
        "required": true
      }
    ],
    "relation_quality": [
      {
        "path": "metrics.relation.final_pair_recall",
        "op": "ge",
        "value": 0.65,
        "required": true
      },
      {
        "path": "metrics.relation.directed_triple_precision",
        "op": "ge",
        "value": 0.9,
        "required": true
      },
      {
        "path": "metrics.relation.directed_triple_recall",
        "op": "ge",
        "value": 0.6,
        "required": true
      },
      {
        "path": "metrics.relation.directed_triple_f1",
        "op": "ge",
        "value": 0.72,
        "required": true
      },
      {
        "path": "metrics.relation.direction_fixture_accuracy",
        "op": "eq",
        "value": 1.0,
        "required": true
      },
      {
        "path": "metrics.relation.qualification_fixture_accuracy",
        "op": "eq",
        "value": 1.0,
        "required": true
      },
      {
        "path": "metrics.relation.exact_evidence_alignment",
        "op": "eq",
        "value": 1.0,
        "required": true
      },
      {
        "path": "metrics.relation.unsupported_canonical_edges",
        "op": "eq",
        "value": 0,
        "required": true
      },
      {
        "path": "metrics.relation.forced_related_to_fallbacks",
        "op": "eq",
        "value": 0,
        "required": true
      }
    ],
    "rescue": [
      {
        "path": "metrics.relation.semantic_rescue_activation_rate",
        "op": "le",
        "value": 0.15,
        "required": false
      }
    ],
    "speed": [
      {
        "path": "metrics.comparison.entity_stage_speed_ratio",
        "op": "gt",
        "value": 1.0,
        "required": true
      },
      {
        "path": "metrics.comparison.full_graphify_speed_ratio",
        "op": "ge",
        "value": 1.5,
        "required": true
      }
    ]
  }
}
