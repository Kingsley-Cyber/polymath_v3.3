{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final_status.schema.json",
  "title": "Graphify Refactor Final Status",
  "type": "object",
  "required": [
    "implementation_complete",
    "e2e_verified",
    "speed_gate_passed",
    "quality_gate_passed",
    "held_out_qualification",
    "production_graph_write_promotion"
  ],
  "properties": {
    "implementation_complete": {"type": "boolean"},
    "e2e_verified": {"type": "boolean"},
    "speed_gate_passed": {"type": "boolean"},
    "quality_gate_passed": {"type": "boolean"},
    "held_out_qualification": {"enum": ["pending", "passed", "failed"]},
    "production_graph_write_promotion": {"enum": ["pending", "passed", "failed"]},
    "workflow_state": {"type": "object"},
    "reports": {"type": "array"},
    "remaining_uncertainty": {"type": "array"}
  },
  "additionalProperties": true
}
